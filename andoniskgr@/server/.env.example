# Copy to server/.env on the Pi. Never commit the copy.

# Loopback only. Tailscale Serve publishes it on the tailnet.
HOST=127.0.0.1
PORT=3000
# true when the browser uses https:// via tailscale serve.
# Set false only for a local http trial. The session cookie is then not Secure.
COOKIE_SECURE=true
# Trust X-Forwarded-* from a proxy on this machine (tailscale serve).
TRUST_PROXY=true
# At least 32 characters. openssl rand -hex 32
SESSION_SECRET=

# Schedules and the allowlist offset use this timezone.
TZ=Europe/Athens
DATA_DIR=./data

# The server connects to Mosquitto on the Pi, not across the LAN.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=door-server
MQTT_PASS=
# MQTT_TLS=1
# MQTT_CA=/etc/mosquitto/certs/ca.crt

# 64 hex characters each (openssl rand -hex 32). Raw 32-byte keys.
# The Pico needs both. The ESP-01 needs only DOOR_HMAC_SECRET.
DOOR_HMAC_SECRET=
ALLOWLIST_HMAC_KEY=
# Relay pulse. Integer milliseconds, 200–10000.
DOOR_OPEN_MS=3000

# Leave blank to disable sending. Toggles in the web UI still apply.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
